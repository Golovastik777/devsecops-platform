<!--
  Wazuh manager rules for kb-assistant.
  Sources (JSON, decoded by the built-in json decoder):
    * application security events: {"event": "guardrail_block", "layer": "input", "client": ...}
    * Falco alerts forwarded by Falcosidekick: {"rule": ..., "priority": ..., "output_fields": {...}}
  IDs 100100-100199 are reserved for this service.
-->
<group name="kb_assistant,llm_security,">

  <rule id="100100" level="5">
    <decoded_as>json</decoded_as>
    <field name="event">^guardrail_block$</field>
    <field name="layer">^input$</field>
    <description>kb-assistant: prompt blocked by input guardrail (client $(client))</description>
    <group>prompt_injection,</group>
  </rule>

  <rule id="100101" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100100</if_matched_sid>
    <same_field>client</same_field>
    <description>kb-assistant: 5+ blocked prompts from one client in 60s - likely prompt-injection probing</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>prompt_injection,attack,</group>
  </rule>

  <rule id="100102" level="12">
    <decoded_as>json</decoded_as>
    <field name="event">^guardrail_block$</field>
    <field name="layer">^output$</field>
    <description>kb-assistant: model answer blocked by output guardrail (possible system prompt leak)</description>
    <group>data_leak,</group>
  </rule>

  <rule id="100103" level="3">
    <decoded_as>json</decoded_as>
    <field name="event">^guardrail_sanitize$</field>
    <description>kb-assistant: instruction-like text removed from knowledge base document $(doc)</description>
    <group>indirect_prompt_injection,</group>
  </rule>

</group>

<group name="falco,container_runtime,">

  <rule id="100150" level="12">
    <decoded_as>json</decoded_as>
    <field name="priority">^Critical$</field>
    <field name="rule">\.+</field>
    <description>Falco CRITICAL: $(rule)</description>
  </rule>

  <rule id="100151" level="8">
    <decoded_as>json</decoded_as>
    <field name="priority">^Error$|^Warning$</field>
    <field name="rule">\.+</field>
    <description>Falco: $(rule)</description>
  </rule>

  <rule id="100152" level="12" frequency="10" timeframe="120">
    <if_matched_sid>100151</if_matched_sid>
    <field name="rule">^Outbound SSH from a container$</field>
    <description>Falco: burst of outbound SSH from containers - possible compromised workload</description>
    <mitre>
      <id>T1021.004</id>
    </mitre>
  </rule>

</group>
